{
	# Plain HTTP for now; TLS is added per site block below.
	auto_https off
}

(app) {
	encode zstd gzip

	# Internal probes are for compose/ops only, never exposed through the proxy.
	handle /api/readyz {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

:80 {
	import app
}
