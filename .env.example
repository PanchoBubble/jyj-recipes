# Copy to .env and replace every change-me before running anywhere real.
POSTGRES_DB=jyj
POSTGRES_USER=jyj
# Keep it URL-safe (letters, digits, - _): compose interpolates it into the backend's DATABASE_URL.
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
# Backend settings. APP_ENV=production requires DATABASE_URL and a real SESSION_SECRET (32+ chars).
APP_ENV=development
# Set false only for plain-http local dev; refused when APP_ENV=production.
SESSION_COOKIE_SECURE=true
# Used when running the backend on the host (make dev). Inside compose the backend always talks to db:5432.
DATABASE_URL=postgresql+psycopg://jyj:change-me@127.0.0.1:5432/jyj

# Host address Caddy publishes 80/443 on. Set to the Pi's LAN IP to avoid exposing other interfaces.
WEB_BIND=0.0.0.0
# LAN hostname devices use (docs/TLS.md). Not named HOSTNAME to avoid clashing with the shell/container variable.
JYJ_HOSTNAME=recipes.home.arpa
# Optional: also serve https://<Pi LAN IP>. Leave empty unless the Pi has a DHCP reservation.
JYJ_LAN_IP=
# internal (Caddy local CA, default) | tailscale | dns (needs a Caddy build with a DNS plugin).
JYJ_TLS=internal
# Only for JYJ_TLS=dns.
# JYJ_DNS_PROVIDER=cloudflare
# JYJ_DNS_API_TOKEN=change-me

# Backend test suite DB (make test-db-up).
TEST_DATABASE_URL=postgresql+psycopg://jyj:jyj@127.0.0.1:55432/jyj_test

# Chat assistant (Codex CLI). Login is done once with `docker compose exec backend codex login --device-auth`, see docs/CODEX.md. No Codex keys belong here.
CODEX_ENABLED=true
CODEX_TIMEOUT_SECONDS=90
# CODEX_MODEL=
