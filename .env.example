# Copy to .env and replace every change-me before running anywhere real.
POSTGRES_DB=jyj
POSTGRES_USER=jyj
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me
# Backend settings. APP_ENV=production requires DATABASE_URL and a real SESSION_SECRET (32+ chars).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://jyj:change-me@127.0.0.1:5432/jyj
TEST_DATABASE_URL=postgresql+psycopg://jyj:jyj@127.0.0.1:55432/jyj_test
