# Site addresses and TLS mode come from the environment (see .env.example and docs/TLS.md).
#   JYJ_HOSTNAME  LAN hostname devices use, default recipes.local
#   JYJ_LAN_IP    optional: also serve https://<ip> (internal cert with an IP SAN)
#   JYJ_TLS       internal (default, option A) | tailscale (option C) | dns (option B, needs a DNS plugin build)

{
	# Clients connecting to https://<ip> send no SNI; without this Caddy has no cert to pick.
	default_sni {$JYJ_DEFAULT_SNI:recipes.local}
}

(tls-internal) {
	tls internal
}

(tls-tailscale) {
	tls {
		get_certificate tailscale
	}
}

(tls-dns) {
	tls {
		dns {$JYJ_DNS_PROVIDER} {env.JYJ_DNS_API_TOKEN}
	}
}

(security-headers) {
	header {
		# 'unsafe-inline' styles: Radix (shadcn) injects <style> tags for scroll locking.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.pexels.com; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "microphone=(self), camera=(self)"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}

# Same problem+json shape as the backend's own 413.
(too-large) {
	header Content-Type application/problem+json
	respond `{"type":"about:blank","title":"Request Entity Too Large","status":413,"detail":"Request body is too large"}` 413
}

(app) {
	encode zstd gzip
	import security-headers

	# Internal probes are for compose/ops only, never exposed through the proxy.
	handle /api/readyz {
		respond 404
	}

	# Slightly above the backend's own caps (photo 10 MiB, voice 5 MiB, plus multipart
	# framing) so oversized uploads stop here and the backend stays the precise limit.
	# request_body only trips while streaming, after the backend has already answered a
	# large Content-Length itself, so declared sizes are refused up front: >= 6 MB and >= 11 MB.
	handle /api/* {
		@transcribe_too_large {
			path /api/v1/chat/transcribe
			header_regexp Content-Length `^0*(?:[1-9]\d{7,}|[6-9]\d{6})$`
		}
		handle @transcribe_too_large {
			import too-large
		}
		@too_large header_regexp Content-Length `^0*(?:[1-9]\d{8,}|1[1-9]\d{6}|[2-9]\d{7})$`
		handle @too_large {
			import too-large
		}
		request_body /api/v1/chat/transcribe {
			max_size 6MB
		}
		request_body {
			max_size 11MB
		}
		# With no trusted_proxies set, Caddy discards client-sent X-Forwarded-For and sends the peer IP.
		reverse_proxy backend:8000
	}

	handle_path /media/* {
		# Photo files get a fresh random name on every upload, so they never change in place.
		header Cache-Control "private, max-age=31536000, immutable"
		root * /srv/media
		file_server
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

# localhost and 127.0.0.1 keep the container healthcheck and on-Pi curl working.
{$JYJ_HOSTNAME:recipes.local} {$JYJ_LAN_IP} localhost 127.0.0.1 {
	import tls-{$JYJ_TLS:internal}
	import app
}
