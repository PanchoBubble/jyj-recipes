# Copy to .env and replace every change-me before running anywhere real. The compose stack runs
# with APP_ENV=production and refuses to start while either value below is still change-me.
POSTGRES_DB=jyj
POSTGRES_USER=jyj
# Keep it URL-safe: compose interpolates it into the backend's DATABASE_URL. Generate with
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# 32+ characters. Generate with
#   openssl rand -base64 48
SESSION_SECRET=change-me
# Only for the backend run on the host (make dev). docker-compose.yml pins production;
# docker-compose.dev.yml switches the containers back to development.
APP_ENV=development
# Set false only for plain-http local dev; refused when APP_ENV=production.
SESSION_COOKIE_SECURE=true
# Used when running the backend on the host (make dev). Inside compose the backend always talks to db:5432.
DATABASE_URL=postgresql+psycopg://jyj:change-me@127.0.0.1:5432/jyj

# Host address Caddy publishes 80/443 on. Set to the Pi's LAN IP to avoid exposing other interfaces.
WEB_BIND=0.0.0.0
# Peers the backend trusts for X-Forwarded-For (uvicorn accepts IPs and CIDRs, comma separated).
# Defaults to the web container's pinned address in docker-compose.yml. Never "*".
# FORWARDED_ALLOW_IPS=10.203.87.10
# LAN hostname devices use (docs/TLS.md). Not named HOSTNAME to avoid clashing with the shell/container variable.
JYJ_HOSTNAME=recipes.home.arpa
# Optional: also serve https://<Pi LAN IP>. Leave empty unless the Pi has a DHCP reservation.
JYJ_LAN_IP=
# internal (Caddy local CA, default) | tailscale | dns (needs a Caddy build with a DNS plugin).
JYJ_TLS=internal
# Only for JYJ_TLS=dns.
# JYJ_DNS_PROVIDER=cloudflare
# JYJ_DNS_API_TOKEN=change-me

# Speech to text (whisper.cpp). Defaults suit the Pi 5; switch to base with `make whisper-download model=base`
# and WHISPER_MODEL_PATH=/var/lib/jyj/whisper/ggml-base.bin.
# WHISPER_MODEL_PATH=/var/lib/jyj/whisper/ggml-tiny.bin
# WHISPER_THREADS=4
# WHISPER_TIMEOUT_SECONDS=30
# STT_MAX_BYTES=5242880
# STT_MAX_SECONDS=60
# Transcripts below this confidence are flagged low_confidence and never auto-sent.
# STT_LOW_CONFIDENCE=0.5
# STT_RATE_LIMIT_PER_MINUTE=20

# Backend test suite DB (make test-db-up).
TEST_DATABASE_URL=postgresql+psycopg://jyj:jyj@127.0.0.1:55432/jyj_test

# Chat assistant (Codex CLI). Login is done once with `docker compose exec backend codex login --device-auth`, see docs/CODEX.md. No Codex keys belong here.
CODEX_ENABLED=true
CODEX_TIMEOUT_SECONDS=90
# CODEX_MODEL=

# Backups (docs/BACKUP.md). COMPOSE_PROFILES=backup makes `make up` start the nightly backup service.
COMPOSE_PROFILES=backup
# Host path, ideally on the Pi's external disk, e.g. /mnt/usb/jyj-backups. Created 0700; dumps are 0600.
BACKUP_DIR=./backups
# Daily run time, HH:MM 24h in TZ.
BACKUP_CRON=03:30
TZ=UTC
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Host user that should own the backup files (`id -u` / `id -g` of the Pi user).
BACKUP_UID=1000
BACKUP_GID=1000
